# --- Meta Model API (https://dev.meta.ai/docs) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Hard ceiling per day, and a stop switch (1 = no model calls at all)
META_MAX_CALLS_PER_DAY=200
META_DISABLED=0

# --- WhatsApp Cloud API test app (your own Meta developer account) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Use the version your app dashboard shows, e.g. v23.0
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- App ---
# openssl rand -hex 32
SESSION_SECRET=
REVIEWER_PASSCODE=
TENANTS=t1:Demo Food Bank (fictional),t2:Other NGO (fictional)
REVIEWERS=ana@demo-foodbank.org:t1,guest@other-ngo.org:t2
# Allowlisted field-worker phones, WhatsApp format without "+": phone:tenant:label
REPORTERS=
CASE_WINDOW_MINUTES=30
RETENTION_DAYS=14
PORT=3000
